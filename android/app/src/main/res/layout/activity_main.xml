<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textAddr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Адрес: —"
        android:textSize="18sp"
        android:textIsSelectable="true"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textToken"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="PIN: —"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textIsSelectable="true"
        app:layout_constraintTop_toBottomOf="@id/textAddr"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Сервер остановлен"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textToken"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textA11y"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Accessibility: ?"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Курсор на телефоне ○"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textA11y"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Start server"
        app:layout_constraintTop_toBottomOf="@id/textOverlay" />

    <Button
        android:id="@+id/btnA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Открыть настройки Accessibility"
        app:layout_constraintTop_toBottomOf="@id/btnToggle" />

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Не оптимизировать батарею (рекомендуется)"
        app:layout_constraintTop_toBottomOf="@id/btnA11y" />

</androidx.constraintlayout.widget.ConstraintLayout>
